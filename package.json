{
  "name": "code-reader-application",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:cli": "pnpm --filter @code-reader/cli build",
    "watch:cli": "pnpm --filter @code-reader/cli watch",
    "build:ui": "pnpm --filter @code-reader/ui build",
    "watch:ui": "pnpm --filter @code-reader/ui watch",
    "build:web": "pnpm --filter @code-reader/web build",
    "watch:web": "pnpm --filter @code-reader/web watch",
    "build:desktop": "pnpm --filter @code-reader/desktop build",
    "watch:desktop": "pnpm --filter @code-reader/desktop watch",
    "start:desktop": "pnpm --filter @code-reader/desktop start",
    "dev:desktop": "pnpm --filter @code-reader/desktop dev",
    "build:diff-algorithm": "pnpm --filter @code-reader/diff-algorithm build",
    "watch:diff-algorithm": "pnpm --filter @code-reader/diff-algorithm dev",
    "test:diff-algorithm": "pnpm --filter @code-reader/diff-algorithm test",
    "benchmark:diff-algorithm": "pnpm --filter @code-reader/diff-algorithm benchmark",
    "build:fuzzy-match-algorithm": "pnpm --filter @code-reader/fuzzy-match-algorithm build",
    "watch:fuzzy-match-algorithm": "pnpm --filter @code-reader/fuzzy-match-algorithm dev",
    "test:fuzzy-match-algorithm": "pnpm --filter @code-reader/fuzzy-match-algorithm test",
    "build:autocomplete-service": "pnpm --filter @code-reader/autocomplete-service build",
    "watch:autocomplete-service": "pnpm --filter @code-reader/autocomplete-service dev",
    "test:autocomplete-service": "pnpm --filter @code-reader/autocomplete-service test",
    "build:format-parser": "pnpm --filter @code-reader/format-parser build",
    "watch:format-parser": "pnpm --filter @code-reader/format-parser dev",
    "test:format-parser": "pnpm --filter @code-reader/format-parser test",
    "build:syntax-parser": "pnpm --filter @code-reader/syntax-parser build",
    "watch:syntax-parser": "pnpm --filter @code-reader/syntax-parser dev",
    "test:syntax-parser": "pnpm --filter @code-reader/syntax-parser test",
    "build:text-buffer": "pnpm --filter @code-reader/text-buffer build",
    "watch:text-buffer": "pnpm --filter @code-reader/text-buffer dev",
    "test:text-buffer": "pnpm --filter @code-reader/text-buffer test",
    "build:search-service": "pnpm --filter @code-reader/search-service build",
    "watch:search-service": "pnpm --filter @code-reader/search-service dev",
    "test:search-service": "pnpm --filter @code-reader/search-service test",
    "build:plugin-system": "pnpm --filter @code-reader/plugin-system build",
    "watch:plugin-system": "pnpm --filter @code-reader/plugin-system dev",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:desktop": "pnpm --filter @code-reader/desktop typecheck",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,css,md,json}'",
    "clean": "rimraf **/dist **/build **/out **/node_modules node_modules packages/desktop/node_modules"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "esbuild"
    ]
  }
}