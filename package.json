{
  "name": "code-reader-application",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:cli": "pnpm --filter @code-reader/cli build",
    "watch:cli": "pnpm --filter @code-reader/cli watch",
    "build:ui": "pnpm --filter @code-reader/ui build",
    "watch:ui": "pnpm --filter @code-reader/ui watch",
    "build:web": "pnpm --filter @code-reader/web build",
    "watch:web": "pnpm --filter @code-reader/web watch",
    "build:desktop": "pnpm --filter @code-reader/desktop build",
    "watch:desktop": "pnpm --filter @code-reader/desktop watch",
    "start:desktop": "pnpm --filter @code-reader/desktop start",
    "dev:desktop": "pnpm --filter @code-reader/desktop dev",
    "build:diff": "pnpm --filter @code-reader/diff-algorithm build",
    "watch:diff": "pnpm --filter @code-reader/diff-algorithm dev",
    "test:diff": "pnpm --filter @code-reader/diff-algorithm test",
    "benchmark:diff": "pnpm --filter @code-reader/diff-algorithm benchmark",
    "build:algorithms": "pnpm --filter @code-reader/algorithms build",
    "watch:algorithms": "pnpm --filter @code-reader/algorithms dev",
    "test:algorithms": "pnpm --filter @code-reader/algorithms test",
    "build:autocomplete": "pnpm --filter @code-reader/autocomplete build",
    "watch:autocomplete": "pnpm --filter @code-reader/autocomplete dev",
    "test:autocomplete": "pnpm --filter @code-reader/autocomplete test",
    "build:parser": "pnpm --filter @code-reader/parser build",
    "watch:parser": "pnpm --filter @code-reader/parser dev",
    "test:parser": "pnpm --filter @code-reader/parser test",
    "build:content-search": "pnpm --filter @code-reader/content-search build",
    "watch:content-search": "pnpm --filter @code-reader/content-search dev",
    "test:content-search": "pnpm --filter @code-reader/content-search test",
    "build:plugin-system": "pnpm --filter @code-reader/plugin-system build",
    "watch:plugin-system": "pnpm --filter @code-reader/plugin-system dev",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:desktop": "pnpm --filter @code-reader/desktop typecheck",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx}' --fix",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,css,md,json}'",
    "clean": "rimraf **/dist **/build **/out **/node_modules node_modules packages/desktop/node_modules"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "esbuild"
    ]
  }
}
