{
  "name": "@code-reader/diff-algorithm",
  "version": "0.1.0",
  "description": "高性能差分算法库 - 提供文本差分、二进制差分、编辑距离、模糊匹配等功能",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./algorithms": {
      "import": "./dist/algorithms/index.js",
      "types": "./dist/algorithms/index.d.ts"
    },
    "./cache": {
      "import": "./dist/cache/index.js",
      "types": "./dist/cache/index.d.ts"
    },
    "./worker": {
      "import": "./dist/worker/index.js",
      "types": "./dist/worker/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx benchmark/index.ts",
    "benchmark:diff": "tsx benchmark/diff-benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "diff",
    "algorithm",
    "text-diff",
    "binary-diff",
    "levenshtein",
    "fuzzy-match",
    "histogram-diff"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "fossil-delta": "^2.0.0"
  },
  "devDependencies": {
    "@code-reader/test-support": "workspace:*",
    "@types/diff-match-patch": "^1.0.36",
    "@vitest/coverage-v8": "^1.3.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
