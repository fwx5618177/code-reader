{
  "name": "@code-reader/format-parser",
  "version": "0.1.0",
  "description": "LaTeX 解析（文档结构、元数据、交叉引用索引）与按内容识别格式、选择解析器的统一入口；Markdown 解析由 @code-reader/markdown-parser 提供",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./latex": {
      "import": "./dist/latex/index.js",
      "types": "./dist/latex/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "parser",
    "latex",
    "tex",
    "ast",
    "format-detection"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@code-reader/markdown-parser": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.3.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
