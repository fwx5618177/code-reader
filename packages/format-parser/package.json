{
  "name": "@code-reader/format-parser",
  "version": "0.1.0",
  "description": "高性能内容解析器 - 提供 Markdown、LaTeX 等格式的解析功能",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./markdown": {
      "import": "./dist/markdown/index.js",
      "types": "./dist/markdown/index.d.ts"
    },
    "./latex": {
      "import": "./dist/latex/index.js",
      "types": "./dist/latex/index.d.ts"
    },
    "./incremental": {
      "import": "./dist/incremental/index.js",
      "types": "./dist/incremental/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx benchmark/index.ts"
  },
  "keywords": [
    "parser",
    "markdown",
    "commonmark",
    "gfm",
    "latex",
    "tex",
    "incremental-parser",
    "ast",
    "syntax-tree"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.3.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
