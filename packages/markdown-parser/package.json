{
  "name": "@code-reader/markdown-parser",
  "version": "0.1.0",
  "description": "零依赖的 Markdown 解析库：CommonMark / GFM 解析器（块级与行内节点都带行列与偏移）、逐行 token 增量解析与流式输入，附 CommonMark 规范一致性测试",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./commonmark": {
      "import": "./dist/commonmark/index.js",
      "types": "./dist/commonmark/index.d.ts"
    },
    "./incremental": {
      "import": "./dist/incremental/index.js",
      "types": "./dist/incremental/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "parser",
    "ast",
    "incremental-parser"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  }
}
