{
  "name": "@code-reader/autocomplete-service-extras",
  "version": "0.1.0",
  "description": "补全扩展：ProseMirror 补全插件（多提供者、触发符或单词触发、面板、键盘导航、结构化插入，桌面端 Markdown 编辑器使用）、文本框补全（textarea / input，桌面端公式源码框使用）与基于它的补全服务适配器，以及 CodeMirror 补全预设（Markdown 编辑器、指定语言的代码编辑器）",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "autocomplete",
    "prosemirror",
    "codemirror"
  ],
  "license": "MIT",
  "dependencies": {
    "@code-reader/autocomplete-service": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.12.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.23.0",
    "jsdom": "^24.0.0",
    "prosemirror-model": "^1.21.0",
    "prosemirror-schema-basic": "^1.2.2",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.33.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6.0.0",
    "@codemirror/state": ">=6.0.0",
    "@codemirror/view": ">=6.0.0",
    "prosemirror-state": ">=1.4.0",
    "prosemirror-view": ">=1.30.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": { "optional": true },
    "@codemirror/state": { "optional": true },
    "@codemirror/view": { "optional": true },
    "prosemirror-state": { "optional": true },
    "prosemirror-view": { "optional": true }
  }
}
