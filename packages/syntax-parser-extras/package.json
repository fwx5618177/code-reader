{
  "name": "@code-reader/syntax-parser-extras",
  "version": "0.1.0",
  "description": "语法解析扩展：语言注册表与高亮引擎、Lezer 增量解析封装与 AST 缓存、正则 LaTeX 块扫描器（与 @code-reader/syntax-parser 分开，按需引入）",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lezer": {
      "import": "./dist/lezer/index.js",
      "types": "./dist/lezer/index.d.ts"
    },
    "./block-scanner": {
      "import": "./dist/block-scanner/index.js",
      "types": "./dist/block-scanner/index.d.ts"
    },
    "./language-registry": {
      "import": "./dist/language-registry/index.js",
      "types": "./dist/language-registry/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "benchmark": "tsx benchmark/parser-benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "language-registry",
    "syntax-highlighting",
    "lezer",
    "incremental-parser",
    "ast-cache",
    "latex"
  ],
  "license": "MIT",
  "dependencies": {
    "@code-reader/syntax-parser": "workspace:*",
    "@lezer/common": "^1.2.1",
    "@lezer/lr": "^1.4.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  }
}
