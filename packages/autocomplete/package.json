{
  "name": "@code-reader/autocomplete",
  "version": "0.1.0",
  "description": "智能补全系统 - 提供通用的自动补全服务、提供者和编辑器适配器",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./service": {
      "import": "./dist/service/index.js",
      "types": "./dist/service/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./spell-check": {
      "import": "./dist/spell-check/index.js",
      "types": "./dist/spell-check/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "autocomplete",
    "auto-complete",
    "completion",
    "intellisense",
    "code-completion",
    "spell-check",
    "prosemirror",
    "codemirror",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@code-reader/auto-complete-algorithm": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.12.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.23.0",
    "@vitest/coverage-v8": "^1.3.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.33.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6.0.0",
    "@codemirror/state": ">=6.0.0",
    "@codemirror/view": ">=6.0.0",
    "prosemirror-state": ">=1.4.0",
    "prosemirror-view": ">=1.30.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "prosemirror-state": {
      "optional": true
    },
    "prosemirror-view": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
