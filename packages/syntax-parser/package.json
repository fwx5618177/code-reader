{
  "name": "@code-reader/syntax-parser",
  "version": "0.1.0",
  "description": "高性能增量解析库 - 提供 Lezer 增量解析、纯 TS Tree-sitter 风格解析器、AST 缓存等功能",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lezer": {
      "import": "./dist/lezer/index.js",
      "types": "./dist/lezer/index.d.ts"
    },
    "./block-scanner": {
      "import": "./dist/block-scanner/index.js",
      "types": "./dist/block-scanner/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx benchmark/parser-benchmark.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "incremental-parser",
    "lezer",
    "tree-sitter",
    "ast-cache",
    "latex",
    "markdown",
    "syntax-highlighting",
    "codemirror"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@code-reader/text-buffer": "workspace:*",
    "@lezer/common": "^1.2.1",
    "@lezer/lr": "^1.4.0",
    "@lezer/highlight": "^1.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.3.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}