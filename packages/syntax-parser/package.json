{
  "name": "@code-reader/syntax-parser",
  "version": "0.1.0",
  "description": "零依赖的手写 LaTeX 解析器（词法、语法、错误恢复与诊断）与 LaTeX 语言配置；语言注册表、高亮引擎、Lezer 增量封装、AST 缓存、块扫描器在 @code-reader/syntax-parser-extras",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./latex": {
      "import": "./dist/latex/index.js",
      "types": "./dist/latex/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "latex",
    "parser",
    "tokenizer",
    "diagnostics",
    "language-configuration"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
