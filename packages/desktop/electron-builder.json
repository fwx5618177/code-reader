{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.codereader.app",
  "productName": "Code Reader",
  "directories": {
    "app": ".app-stage",
    "output": "release",
    "buildResources": "assets"
  },
  "files": ["dist/**/*"],
  "afterPack": "./scripts/adhoc-sign.mjs",
  "asarUnpack": ["**/*.node"],
  "extraResources": [
    {
      "from": "assets/icons",
      "to": "assets/icons",
      "filter": ["**/*"]
    },
    {
      "from": "assets/dictionaries",
      "to": "assets/dictionaries",
      "filter": ["**/*"]
    },
    {
      "from": "assets/ocr",
      "to": "assets/ocr",
      "filter": ["**/*"]
    },
    {
      "from": "assets/plugins",
      "to": "assets/plugins",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "assets/icons/icon_512x512.png",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "artifactName": "Code-Reader-${version}-mac-${arch}.${ext}",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist"
  },
  "dmg": {
    "icon": "assets/icons/icon_512x512.png",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "icon": "assets/icons/app-icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/icons/app-icon.png",
    "uninstallerIcon": "assets/icons/app-icon.png",
    "installerHeaderIcon": "assets/icons/app-icon.png",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Code Reader"
  },
  "linux": {
    "icon": "assets/icons",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Development",
    "maintainer": "Code Reader Team",
    "synopsis": "A powerful code reading and knowledge management tool",
    "description": "Code Reader is a personal knowledge base and writing app with Markdown and LaTeX support."
  },
  "publish": {
    "provider": "github",
    "owner": "fwx5618177",
    "repo": "code-reader"
  }
}
