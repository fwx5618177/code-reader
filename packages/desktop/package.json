{
  "name": "@code-reader/desktop",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/index.mjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently --success first --kill-others \"pnpm dev:vite\" \"pnpm dev:electron\" || true",
    "dev:vite": "vite",
    "dev:electron": "vite build && wait-on dist/main/index.mjs && nodemon --watch src/main --ext ts --exec \"vite build && electron .\"",
    "start": "pnpm build && pnpm electron",
    "electron": "electron .",
    "build": "vite build",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3",
    "postinstall": "npx @electron/rebuild -f -w better-sqlite3 || true",
    "pack": "pnpm build && node scripts/stage-app.mjs && electron-builder --dir",
    "dist": "pnpm build && node scripts/stage-app.mjs && electron-builder",
    "dist:mac": "pnpm build && node scripts/stage-app.mjs && electron-builder --mac",
    "dist:win": "pnpm build && node scripts/stage-app.mjs && electron-builder --win",
    "dist:linux": "pnpm build && node scripts/stage-app.mjs && electron-builder --linux",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:writing": "vitest run --reporter=verbose src/render/lib/writing",
    "typecheck": "tsc --noEmit",
    "plugin-tools": "esbuild scripts/plugin-tools.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.plugin-tools.mjs --log-level=warning && node scripts/.plugin-tools.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@code-reader/autocomplete-service": "workspace:*",
    "@code-reader/diff-algorithm": "workspace:*",
    "@code-reader/fuzzy-match-algorithm": "workspace:*",
    "@code-reader/search-service": "workspace:*",
    "@code-reader/text-buffer": "workspace:*",
    "@codemirror/autocomplete": "^6.16.0",
    "@codemirror/commands": "^6.5.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.6.4",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.1",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.3",
    "@lezer/highlight": "^1.2.0",
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "better-sqlite3": "^11.3.0",
    "diff-match-patch": "^1.0.5",
    "fossil-delta": "^2.0.0",
    "fs-extra": "^11.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.562.0",
    "markdown-it": "^14.1.0",
    "openai": "^4.67.0",
    "pdfjs-dist": "4.10.38",
    "prismjs": "^1.29.0",
    "prosemirror-commands": "^1.5.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.0",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.12.0",
    "prosemirror-model": "^1.21.0",
    "prosemirror-schema-basic": "^1.2.2",
    "prosemirror-schema-list": "^1.3.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.33.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^2.2.3",
    "tesseract.js": "5.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@testing-library/react": "^14.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff-match-patch": "^1.0.36",
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "@types/prismjs": "^1.26.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-window": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^1.3.0",
    "@vitest/ui": "^1.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.20.0",
    "jsdom": "^24.0.0",
    "nodemon": "^3.1.0",
    "sass": "^1.72.0",
    "sharp": "^0.33.0",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^1.3.0",
    "wait-on": "^7.2.0"
  }
}
