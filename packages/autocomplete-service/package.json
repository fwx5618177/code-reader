{
  "name": "@code-reader/autocomplete-service",
  "version": "0.1.0",
  "description": "智能补全系统：补全服务（缓存、防抖、模糊排序）、补全提供者（Markdown、Emoji、代码片段）与 CodeMirror 适配器；ProseMirror 适配器在 @code-reader/autocomplete-service-extras",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./service": {
      "import": "./dist/service/index.js",
      "types": "./dist/service/index.d.ts"
    },
    "./providers": {
      "import": "./dist/providers/index.js",
      "types": "./dist/providers/index.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "autocomplete",
    "auto-complete",
    "completion",
    "intellisense",
    "code-completion",
    "codemirror",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@code-reader/fuzzy-match-algorithm": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.12.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.23.0",
    "jsdom": "^24.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.3.0"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": ">=6.0.0",
    "@codemirror/state": ">=6.0.0",
    "@codemirror/view": ">=6.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
